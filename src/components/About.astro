---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
  profile: CollectionEntry<'profile'>['data'];
}
const { lang, profile } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="bg-paper text-ink">
  <div class="shell grid gap-x-10 gap-y-10 py-20 lg:grid-cols-12 lg:py-32">
    <h2 class="display section-title lg:col-[1/-1]">{t('about.title')}</h2>

    <div class="lg:col-[1/6]">
      <Image
        src={profile.portrait}
        alt={profile.portraitAlt}
        widths={[480, 720, 1080]}
        sizes="(min-width: 64rem) 38vw, 100vw"
        class="duotone aspect-[4/5] w-full object-cover"
      />
    </div>

    <div class="lg:col-[7/-1]">
      <div class="prose-bio max-w-[62ch] text-lead [&>p:first-child]:text-[1.7rem] [&>p:first-child]:leading-(--leading-bio-intro,1.3) [&>p:first-child]:font-medium">
        <slot />
      </div>

      <div class="mt-14 grid gap-10 sm:grid-cols-2">
        <div>
          <h3 class="display-sm border-b-2 border-ink pb-2 text-2xl uppercase">{t('about.education')}</h3>
          <ul class="mt-4 space-y-5">
            {profile.education.map((item) => (
              <li>
                <p class="font-semibold leading-snug">{item.title}</p>
                <p class="text-ink/75">{item.place}, {item.years}</p>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="display-sm border-b-2 border-ink pb-2 text-2xl uppercase">{t('about.awards')}</h3>
          <ul class="mt-4 space-y-5">
            {profile.awards.map((item) => (
              <li class="grid grid-cols-[3.5rem_1fr] gap-3">
                <span class="display-sm text-xl text-cobalt">{item.year}</span>
                <span class="font-semibold leading-snug">{item.title}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
