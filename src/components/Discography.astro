---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { pick, useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
  items: CollectionEntry<'albums'>[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);
const albums = [...items].sort((a, b) => b.data.year - a.data.year);
---

<section id="music" class="bg-cobalt">
  <div class="shell py-20 lg:py-32">
    <h2 class="display section-title">{t('music.title')}</h2>

    <ul class="mt-12 grid gap-x-5 gap-y-12 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4">
      {albums.map(({ data }) => (
        <li>
          <Image
            src={data.cover}
            alt=""
            widths={[320, 480, 720]}
            sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 45vw, 100vw"
            class="album-cover aspect-square w-full object-cover shadow-[0.5rem_0.5rem_0_0_var(--color-ink)]"
          />
          <div class="mt-6 flex items-baseline justify-between gap-3">
            <h3 class="display text-4xl" lang="en">{data.title}</h3>
            <p class="display-sm text-xl text-brass">{data.year}</p>
          </div>
          <p class="mt-2 text-paper/80">{pick(data.format, lang)}</p>
          <p class="mt-2 max-w-[40ch]">{pick(data.note, lang)}</p>
          {data.link && (
            <a href={data.link} class="mt-3 inline-block font-semibold underline decoration-brass decoration-2 underline-offset-4 hover:text-brass" rel="noopener" target="_blank">
              {t('music.listen')}<span class="sr-only">: {data.title}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
