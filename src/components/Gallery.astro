---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { pick, useTranslations, type Locale } from '@/i18n/ui';

interface Props {
  lang: Locale;
  items: CollectionEntry<'gallery'>[];
}
const { lang, items } = Astro.props;
const t = useTranslations(lang);

const photos = await Promise.all(
  items.map(async ({ data }) => {
    const full = await getImage({ src: data.image, width: 1800, format: 'webp' });
    const ratio = data.image.width / data.image.height;
    return { ...data, full: full.src, shape: ratio < 0.9 ? 'tall' : ratio > 1.3 ? 'wide' : 'square' };
  }),
);
---

<section id="gallery" class="bg-ink">
  <div class="shell py-20 lg:py-32">
    <h2 class="display section-title">{t('gallery.title')}</h2>

    <ul class="mt-12 grid auto-rows-[44vw] grid-flow-dense grid-cols-2 gap-2 sm:auto-rows-[30vw] md:grid-cols-4 md:gap-3 lg:mt-16 lg:auto-rows-[min(21vw,19rem)]">
      {photos.map((photo, i) => (
        <li class:list={[photo.shape === 'tall' && 'row-span-2', photo.shape === 'wide' && 'col-span-2']}>
          <button
            type="button"
            class="group relative block h-full w-full cursor-zoom-in overflow-hidden bg-cobalt"
            data-photo={photo.full}
            data-index={i}
            aria-label={`${t('gallery.open')}: ${pick(photo.alt, lang)}`}
          >
            <Image
              src={photo.image}
              alt={pick(photo.alt, lang)}
              widths={[360, 640, 960]}
              sizes={photo.shape === 'wide' ? '(min-width: 48rem) 50vw, 100vw' : '(min-width: 48rem) 25vw, 50vw'}
              class:list={['h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]', i % 4 === 2 ? 'duotone-brass' : 'duotone']}
            />
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog
    class="m-0 h-full max-h-none w-full max-w-none bg-ink-deep/97 p-0 text-paper backdrop:bg-ink-deep"
    aria-label={t('gallery.title')}
    data-lightbox
  >
    <div class="grid h-full grid-rows-[auto_1fr_auto]">
      <div class="flex items-center justify-between px-5 py-4">
        <p class="display-sm text-lg" data-count></p>
        <button type="button" class="display-sm cursor-pointer px-2 py-1 text-lg uppercase hover:text-brass" data-close>{t('gallery.close')}</button>
      </div>
      <div class="relative min-h-0 px-4">
        <img src="" alt="" class="absolute inset-0 m-auto max-h-full max-w-full object-contain" data-full />
      </div>
      <div class="flex items-center justify-between gap-4 px-5 py-4">
        <button type="button" class="display-sm cursor-pointer px-2 py-1 text-lg uppercase hover:text-brass" data-prev>{t('gallery.prev')}</button>
        <p class="hidden text-center text-mist sm:block" data-caption></p>
        <button type="button" class="display-sm cursor-pointer px-2 py-1 text-lg uppercase hover:text-brass" data-next>{t('gallery.next')}</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];
  if (dialog && triggers.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-full]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-caption]')!;
    const count = dialog.querySelector<HTMLElement>('[data-count]')!;
    let current = 0;

    const show = (index: number) => {
      current = (index + triggers.length) % triggers.length;
      const trigger = triggers[current];
      const alt = trigger.querySelector('img')?.alt ?? '';
      img.src = trigger.dataset.photo!;
      img.alt = alt;
      caption.textContent = alt;
      count.textContent = `${current + 1} / ${triggers.length}`;
    };

    triggers.forEach((trigger, i) =>
      trigger.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).tagName === 'DIV') dialog.close();
    });
    dialog.addEventListener('close', () => {
      img.src = '';
      triggers[current].focus();
    });
  }
</script>
